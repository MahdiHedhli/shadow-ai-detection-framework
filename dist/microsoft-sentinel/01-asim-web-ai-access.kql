// SAI-001: Source-agnostic AI web access using Sentinel ASIM
// Prerequisite: watchlist alias ShadowAIProviders, SearchKey = domain.
let Lookback = 7d;
let Catalog = materialize(
    _GetWatchlist('ShadowAIProviders')
    | project SearchKey=tolower(SearchKey), ProviderId, ProviderName, ProductName, Capability, Channel
);
let ShadowAI_Domains = toscalar(Catalog | summarize make_set(SearchKey));
_Im_WebSession(starttime=ago(Lookback), url_has_any=ShadowAI_Domains)
| where isnotempty(Url)
| extend NormalizedUrl = iif(Url matches regex @"^[A-Za-z][A-Za-z0-9+.-]*://", Url, strcat("https://", Url))
| extend Host = tolower(trim_end(@"\.$", tostring(parse_url(NormalizedUrl).Host)))
| extend DomainCandidates = ShadowAI_Domains
| mv-apply MatchedDomain = DomainCandidates to typeof(string) on (
    where Host == MatchedDomain or Host endswith strcat(".", MatchedDomain)
)
| lookup kind=leftouter Catalog on $left.MatchedDomain == $right.SearchKey
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), SampleUrls=make_set(Url, 5), Products=make_set(EventProduct, 5)
  by SrcIpAddr, SrcHostname, SrcUsername, SrcProcessName, MatchedDomain, ProviderId, ProviderName, ProductName, Capability, Channel
| extend EvidenceLevel=2, Confidence="Medium", Disposition="Unreviewed"
| order by Events desc

