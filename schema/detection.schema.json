{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/shadow-ai/detection.schema.json",
  "title": "Portable Shadow AI detection specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "objective",
    "status",
    "evidence_level",
    "confidence",
    "signal_families",
    "required_fields",
    "limitations",
    "platforms"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^SAI-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 8},
    "objective": {"type": "string", "minLength": 20},
    "status": {"enum": ["draft", "hunting", "candidate", "production", "retired"]},
    "evidence_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"enum": ["low", "medium", "high"]},
    "signal_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["endpoint", "network", "dns", "browser", "identity", "oauth", "cloud", "dlp", "agent", "mcp", "business"]}
    },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 10}
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "references": {
      "type": "array",
      "items": {"type": "string", "format": "uri"}
    }
  }
}

