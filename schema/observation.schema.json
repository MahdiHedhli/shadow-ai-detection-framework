{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/shadow-ai-observation-1.0.json",
  "title": "Shadow AI endpoint observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "collected_at",
    "collector",
    "device",
    "scope",
    "safety",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "observation_id": { "type": "string", "format": "uuid" },
    "collected_at": { "type": "string", "format": "date-time" },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "partial", "errors"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "partial": { "type": "boolean" },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "os_family", "os_version", "architecture"],
      "properties": {
        "hostname": { "type": "string", "minLength": 1, "maxLength": 255 },
        "os_family": { "enum": ["windows", "macos", "linux", "unknown"] },
        "os_version": { "type": "string", "maxLength": 200 },
        "architecture": { "type": "string", "maxLength": 100 }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["processes", "known_paths", "browser_extensions", "installed_software"]
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_collected",
        "raw_command_line_collected",
        "environment_values_collected",
        "network_requests_made",
        "full_disk_search_performed",
        "symlinks_followed"
      ],
      "properties": {
        "content_collected": { "const": false },
        "raw_command_line_collected": { "const": false },
        "environment_values_collected": { "const": false },
        "network_requests_made": { "const": false },
        "full_disk_search_performed": { "const": false },
        "symlinks_followed": { "const": false }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "observed_at",
        "category",
        "indicator_id",
        "provider_id",
        "capability",
        "confidence",
        "evidence_level",
        "subject_user",
        "attributes"
      ],
      "properties": {
        "finding_id": { "type": "string", "format": "uuid" },
        "observed_at": { "type": "string", "format": "date-time" },
        "category": {
          "enum": ["process", "software", "model_directory", "config_file", "browser_extension"]
        },
        "indicator_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "capability": { "type": "string", "minLength": 1, "maxLength": 100 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "evidence_level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "subject_user": { "type": ["string", "null"], "maxLength": 200 },
        "attributes": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": ["string", "integer", "number", "boolean", "null"]
          }
        }
      }
    }
  }
}
